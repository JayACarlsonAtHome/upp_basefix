+// a == b; integers of different signedness by value (no negative number equals an unsigned one)
+template <class T, class K>
+constexpr bool findarg_equal__(const T& a, const K& b)
+{
+	if constexpr(std::is_integral_v<T> && std::is_integral_v<K> && std::is_signed_v<T> != std::is_signed_v<K>) {
+		if constexpr(std::is_signed_v<T>)
+			return a >= 0 && (unsigned long long)a == (unsigned long long)b;
+		else
+			return b >= 0 && (unsigned long long)a == (unsigned long long)b;
+	}
+	else
+		return a == b;
+}
